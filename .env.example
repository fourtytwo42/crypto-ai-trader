# Database (REQUIRED)
DATABASE_URL=postgresql://trading_user:password@localhost:5432/bitcoin_trading

# Model Storage (REQUIRED)
MODEL_DIR=models

# Data Storage (REQUIRED)
DATA_DIR=data

# API Configuration (REQUIRED)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Training Configuration (REQUIRED)
TRAIN_DEVICE=cuda
TRAIN_BATCH_SIZE=32
TRAIN_LEARNING_RATE=0.0001
TRAIN_EPOCHS=100
TRAIN_EARLY_STOPPING_PATIENCE=10
TRAIN_VALIDATION_SPLIT=0.15

# Model Configuration (REQUIRED)
MODEL_TYPE=patchtst
MODEL_CONTEXT_LENGTH=128
MODEL_HORIZON=1
MODEL_HIDDEN_SIZE=512
MODEL_NUM_LAYERS=6
MODEL_PATCH_LENGTH=16
MODEL_STRIDE=8

# Signal Generation - Base (REQUIRED)
SIGNAL_THRESHOLD=0.005

# Signal Generation - Volatility Adaptive
SIGNAL_VOLATILITY_ADAPTIVE=true
SIGNAL_BASELINE_VOLATILITY=0.02
SIGNAL_VOLATILITY_MULTIPLIER_MIN=0.5
SIGNAL_VOLATILITY_MULTIPLIER_MAX=2.0
SIGNAL_VOLATILITY_WINDOW=ret_std_7

# Signal Generation - Uncertainty Band
SIGNAL_UNCERTAINTY_ENABLED=true
SIGNAL_MAX_UNCERTAINTY_SPREAD=0.03

# Position Management
MIN_HOLDING_PERIODS=1
POSITION_SIZING_ENABLED=false
POSITION_MAX_SIZE=1.0
POSITION_MIN_SIZE=0.1

# Backtesting Configuration (REQUIRED)
BACKTEST_FEES=0.001
BACKTEST_SLIPPAGE=0.0005
BACKTEST_TRAIN_WINDOW=1825
BACKTEST_TEST_WINDOW=365

# Walk-Forward Configuration (REQUIRED)
WALK_FORWARD_PURGE_DAYS=1
WALK_FORWARD_EMBARGO_DAYS=0

# Logging (REQUIRED)
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=json
